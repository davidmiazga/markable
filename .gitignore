# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/

# Environment
.env
.env.*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Tauri build artifacts
*.dmg
*.app
*.deb
*.AppImage
*.msi

# Built core plugin IIFE bundles (generated by npm run build:plugins)
# These are build outputs, not source files — regenerated before tauri build.
# Tauri resource globs are relative to src-tauri/, so the output path is
# src-tauri/plugins/core/ (matching bundle.resources entry "plugins/core/*").
src-tauri/plugins/core/*.js

# Claude local settings (may contain API keys)
.claude/settings.local*.json

# dm-software-machine runtime
.dm-software-machine/runs/
.dm-software-machine/install-manifest.json
__pycache__/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
